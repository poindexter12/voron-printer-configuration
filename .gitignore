# On the printer this repo IS printer_data, which contains runtime dirs
# (gcodes/, logs/, comms/, .moonraker.uuid, ...) that must never be
# committed by the hourly backup. Whitelist the intentional content.
/*

# Except these
!/.gitignore
!/.claude/
!/.github/
!/ruff.toml
!/config/
!/database/

# Moonraker's SQLite store rewrites its bytes on nearly every operation, so
# tracking it produced a commit an hour with no content change - 285 of the
# first 422 commits, 66MB of blobs. That churn diverged the Pi from origin and
# silently blocked backup pushes for two weeks (2026-09-08 to 2026-09-22).
# It holds print history and Spoolman links, not printer configuration, so
# losing it on a rebuild costs convenience rather than a working machine.
database/moonraker-sql.db
!/backup/
!/docs/
!/ssh/
!/slicer-profiles/
!/models/
!/observability/
!/powerpi/
!/*.md

# Machine-local Claude settings: absolute hook paths and personal permission
# allowlists. Shared project config belongs in .claude/settings.json.
.claude/settings.local.json

# Ignore all .env files anywhere in the tree
**/.env

# Ignore all log files
**/*.log

# Runtime state written by configuration_backup.sh when a push is rejected.
# backup/ is whitelisted above, so without this the failure sentinel would
# itself be committed - and become a new source of the churn it reports on.
backup/.push-failed

# Editor swap/backup files
**/*.swp
**/*.swo
**/*~
**/*.bkp

# Python things
**/venv/
**/.venv/
**/__pycache__/
